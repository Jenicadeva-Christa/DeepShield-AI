{
  "name": "deepshield-ai-server",
  "version": "1.0.0",
  "description": "DeepShield AI Server - Backend API & AI Engine",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:start": "node scripts/start-db.js",
    "seed": "node src/scripts/seed.js",
    "train": "node src/scripts/trainModels.js",
    "evaluate": "node src/scripts/evaluateModels.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:agile": "jest --testPathPattern=sprint --runInBand --detectOpenHandles --forceExit",
    "test:sprints": "jest --testPathPattern=sprint --runInBand --detectOpenHandles --forceExit",
    "test:voice": "jest tests/voiceRecognition.test.js --runInBand --detectOpenHandles --forceExit",
    "test:email": "node src/scripts/testEmail.js"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.17.0",
    "@vladmandic/face-api": "^1.7.12",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "compromise": "^14.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.0",
    "meyda": "^5.6.3",
    "mongoose": "^8.2.4",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.0.1",
    "nodemailer": "^6.9.13",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "sharp": "^0.33.3",
    "socket.io": "^4.7.5",
    "tesseract.js": "^5.0.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.8",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  }
}
